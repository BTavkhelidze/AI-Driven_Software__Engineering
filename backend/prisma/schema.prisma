// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(uuid())    // Secure, non-sequential UUID for public APIs
  name        String   @db.VarChar(255)
  slug        String   @unique                // Clean URL identifier (e.g., "gaming-mechanical-keyboard")
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)     // Explicit financial precision mapping to MySQL DECIMAL type
  stock       Int      @default(0)
  imageUrl    String?  @db.VarChar(512)
  isActive    Boolean  @default(true)         // Flag to handle clean database soft deletes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Setting up relations to categorize products cleanly
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([slug]) // Performance index for quick URL-based query lookups
}

model Category {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  slug        String    @unique
  products    Product[] // One-to-many relation mapping back to Products
  createdAt   DateTime  @default(now())
}